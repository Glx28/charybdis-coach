  "purpose_rules": [
    {
      "pattern": "command palette|cmdpal",
      "icon": {
        "src": "./assets/app-icons/command-palette.png",
        "name": "PowerToys Command Palette"
      }
    },
    {
      "pattern": "powertoys run|run launcher",
      "icon": {
        "src": "./assets/app-icons/powertoys-run.ico",
        "name": "PowerToys Run"
      }
    },
    {
      "pattern": "new\\+|create from template",
      "icon": {
        "src": "./assets/app-icons/powertoys-newplus.ico",
        "name": "PowerToys New+"
      }
    },
    {
      "pattern": "advanced paste",
      "icon": {
        "src": "./assets/app-icons/powertoys-advanced-paste.png",
        "name": "PowerToys Advanced Paste"
      }
    },
    {
      "pattern": "screenshot|snip",
      "icon": {
        "src": "./assets/app-icons/snipping-tool.png",
        "name": "Windows Snipping Tool"
      }
    },
    {
      "pattern": "task manager",
      "icon": {
        "src": "./assets/app-icons/task-manager.ico",
        "name": "Windows Task Manager"
      }
    }
